{
  "eval_set_id": "nl2sql_evalset",
  "name": "NL2SQL golden dataset",
  "description": "Natural-language questions over the SQLite banking schema in data/nl2sql_schema.sql. Expected answers are result sets, not SQL strings: many queries are correct and only the rows settle it. The last three cases are designed to fail on the first attempt so that the self-healing loop is actually exercised rather than assumed.",
  "eval_cases": [
