      "conversation": [
        {
          "user_content": {
            "parts": [
              {
                "text": "How many customers are there?"
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "run_sql_query"
              }
            ],
            "tool_responses": [
              {
                "name": "run_sql_query",
                "response": {
                  "expected_rows": [
                    [
                      5
                    ]
                  ]
                }
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "There are 5 customers."
              }
            ]
          }
        }
      ]
    },
